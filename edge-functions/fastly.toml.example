# This file describes a Fastly Compute package. To learn more visit:
# https://www.fastly.com/documentation/reference/compute/fastly-toml
#
# Copy to fastly.toml and fill in local secret_stores values. fastly.toml is
# gitignored so OAuth secrets are not committed.

authors = []
cloned_from = "https://github.com/adobe/aem-edge-functions-boilerplate"
description = "YouTube captions OAuth proxy for Adobe Labs"
language = "javascript"
manifest_version = 3
name = "youtube-captions"
service_id = ""

[scripts]
  post_init = "npm install"

[local_server]

  [local_server.backends]

    [local_server.backends.googleoauth]
      url = "https://oauth2.googleapis.com"
      override_host = "oauth2.googleapis.com"

    [local_server.backends.googleapis]
      url = "https://www.googleapis.com"
      override_host = "www.googleapis.com"

  [local_server.secret_stores]

    [[local_server.secret_stores.secret_default]]
      key = "YOUTUBE_OAUTH_CLIENT_ID"
      data = "replace-me"

    [[local_server.secret_stores.secret_default]]
      key = "YOUTUBE_OAUTH_CLIENT_SECRET"
      data = "replace-me"

    [[local_server.secret_stores.secret_default]]
      key = "YOUTUBE_OAUTH_REFRESH_TOKEN"
      data = "replace-me"
